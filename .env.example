# Model API credentials for the planner/worker/critic/guardrail/synthesizer agents.
#
# You can also set these from the running dashboard's "⚙ Model API" settings panel,
# which persists them to a gitignored model-config.json (file values win over env vars)
# and lets you pick a provider from a dropdown instead of remembering these names.
#
# AGENT_PROVIDER selects the backend: "openai" (default), "deepseek", or "anthropic".
AGENT_PROVIDER=deepseek
AGENT_MODEL=deepseek-v4-flash

# openai / deepseek (OpenAI-compatible — set OPENAI_BASE_URL for gateways/proxies):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# anthropic (Claude's own Messages API — not OpenAI-compatible, its own key/base URL):
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Other provider examples:
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
#
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
#
# DeepSeek key: https://platform.deepseek.com/api_keys

# Optional overrides
# RESEARCH_REPORT_AGENT_DB=.data/research-report-agent.sqlite3
# RESEARCH_REPORT_AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
